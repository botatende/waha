FROM node:22-bookworm-slim

WORKDIR /app

# VNC + display tools
RUN apt-get update && apt-get install -y --no-install-recommends x11vnc novnc net-tools xvfb chromium \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p ~/.vnc && x11vnc -storepasswd "" ~/.vnc/passwd 2>/dev/null || true

# Source-built WAHA dist + deps
COPY dist /app/dist
COPY node_modules /app/node_modules
COPY package.json /app/package.json

# headless: false (VNC display)
RUN sed -i "s/headless: true/headless: false/g" /app/dist/core/engines/webjs/session.webjs.core.js || true

# Fix whatsapp-web.js Client.js: launchUtils.refreshQR() com fallback condicional
# (nunca Cmd.refreshQR sem verificar). Versionado em image/patch-wwjs-client.js.
COPY image/patch-wwjs-client.js /app/image/patch-wwjs-client.js
RUN node /app/image/patch-wwjs-client.js

# wa-connect service + entrypoint (VNC pool)
RUN mkdir -p /app/wa-connect
COPY image/wa-connect/ /app/wa-connect/
WORKDIR /app/wa-connect
RUN npm install --omit=dev 2>/dev/null || true
WORKDIR /app
COPY image/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 3000 3001 6080 5900 7020 7021 7022
ENTRYPOINT ["/entrypoint.sh"]
